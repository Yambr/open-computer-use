#
# Fleet bring-up environment. Copy to `.env` (gitignored) and set real values.
# The two embed/session secrets are fail-closed: compose refuses to start
# without them (no default), because a default-keyed deployment would verify
# any forged embed token. Generate each with `openssl rand -hex 32`.

# Web UI BFF — required, >=32 bytes each. No default by design.
OCU_EMBED_VERIFY_SECRET=
OCU_SESSION_SECRET=

# Web UI BFF — optional, shown with their compose defaults.
OCU_EMBED_AUDIENCE=ocu-webui

# Control's Docker-socket group. Control (uid 65532) joins this gid to read the
# socket for the per-session container lifecycle. Default 0 fits Docker Desktop
# (socket is root:root). On a native Linux/Lima dockerd the socket is owned by a
# distinct `docker` gid — set it here:
#   OCU_DOCKER_GID=$(stat -c '%g' /var/run/docker.sock)
OCU_DOCKER_GID=0

# Object-store + MinIO — optional, shown with their compose defaults.
OCU_S3_ACCESS_KEY_ID=ocu-fleet-root
OCU_S3_SECRET_ACCESS_KEY=ocu-fleet-secret-key
OCU_S3_BUCKET=ocu-fleet
OCU_FILESYSTEM_ID=fs-fleet

# Guest image for the sandbox. The default is the python3-bearing FAT guest:
# the chat file tools (create_file/view/str_replace) project onto python3, so a
# stripped guest yields a dead first chat input (task #122). Build it per the
# "Running the journey suite" section of README.md (see task #345). The stripped
# tags remain available: ocu-guest:assembled (distroless, no shell),
# ocu-guest:assembled-demo (static busybox, storage-chain demo scripts).
OCU_GUEST_IMAGE=ocu-guest:poc-fat
OCU_GUEST_IMAGE_ALLOW=ocu-guest:assembled-demo

# Download exfil control: which stored-object prefixes are byte-downloadable.
# /outputs = deliverables only (NFR-SEC-73); bare / is a matches-nothing sentinel,
# * reopens the exfil hole. Do not widen without the storage-scope review.
OCU_DOWNLOADABLE_PREFIXES=/outputs

# Admin (ocu-admin) operator console — required, >=32 bytes for the session
# secret. No default by design (see docker-compose.fleet.yml): a bcrypt hash
# contains literal `$` characters compose cannot round-trip through a
# ${VAR:-default} interpolation, so even the demo values must be set here
# rather than inlined in the compose file. Demo values below are for local
# `up` only — regenerate the hash for any shared/non-throwaway deployment with
# `htpasswd -nbBC 12 <user> <password>` (bcrypt cost 12, matching
# web/src/lib/auth/credential.ts BCRYPT_COST) and the secret with
# `openssl rand -hex 32`.
OCU_ADMIN_OPERATOR_USER=demo-operator
# bcrypt(cost=12) of the literal password "ocu-fleet-demo-password". Single-
# quoted: a bcrypt hash's literal `$` segments would otherwise be re-
# interpolated by compose's .env parser (unquoted/double-quoted values ARE
# interpolated; single-quoted values are used literally).
OCU_ADMIN_OPERATOR_BCRYPT_HASH='$2y$12$HyM2r/f.AuDuylnbZBtSc.z8ac7gq.K17yr75SSw2dStYjqlQ5r6m'
OCU_ADMIN_SESSION_SECRET=ocu-fleet-demo-admin-session-secret-32-bytes-min
