{
  "workload_trust_profile": "internal_workforce",
  "mount_intents": [
    {
      "destination": "/mnt/user-data/uploads",
      "filesystem_id": "fs-fleet",
      "read_only": true
    },
    {
      "destination": "/mnt/user-data/outputs",
      "filesystem_id": "fs-fleet",
      "read_only": false
    }
  ],
  "egress_policy": {
    "default_deny": true
  },
  "resource_caps": {
    "cpu_cores": 2,
    "memory_bytes": 2147483648,
    "pids_limit": 512
  },
  "exec_timeout_seconds": 55
}
